# mem0ai@3.1.8 declares an optional peer dependency on
# @anthropic-ai/sdk@^0.40.1, which the root project's real, current
# @anthropic-ai/sdk@^0.126.0 doesn't satisfy (0.x caret ranges are
# patch-only). The conflicting peer is optional and unused -- only
# mem0ai's plain MemoryClient.add/search are called, none of its
# Anthropic-specific helpers -- so legacy peer dep resolution is safe
# here. Without this file, `npm ci` (which CI runs, unlike an interactive
# `npm install --legacy-peer-deps`) fails outright with ERESOLVE before
# a single test or build step runs.
legacy-peer-deps=true
