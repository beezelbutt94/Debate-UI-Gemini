# Copy to .env. Everything defaults to the safe setting: simulated model,
# sandboxed side effects. Flip them deliberately, one at a time.

# --- Execution mode -----------------------------------------------------------
# simulated | claude_code
LLM_MODE=simulated
# true = PRs/emails/posts/ad changes are simulated
SANDBOX_MODE=true
# required for LLM_MODE=claude_code
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Access -------------------------------------------------------------------
# set before exposing the API beyond localhost
OPERATOR_TOKEN=
# shared with CI for /deployments and /canary
DEPLOYMENT_SECRET=

# --- Budgets ------------------------------------------------------------------
DAILY_AGENT_BUDGET_USD=50
DAILY_GLOBAL_BUDGET_USD=200
ADS_DAILY_BUDGET_USD=100

# --- GitHub -------------------------------------------------------------------
GITHUB_TOKEN=
# owner/repo that bug reports turn into PRs against
DEFAULT_REPO=
GITHUB_ACTOR_NAME=Polsia Agent
GITHUB_ACTOR_EMAIL=agent@example.com

# --- Outreach -----------------------------------------------------------------
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_PUBLIC_KEY=
OUTREACH_FROM_EMAIL=outreach@example.com
OUTREACH_FROM_NAME=Polsia

# --- Other integrations -------------------------------------------------------
X_USER_ACCESS_TOKEN=
META_ADS_TOKEN=
STRIPE_WEBHOOK_SECRET=
CALCOM_WEBHOOK_SECRET=
SENTRY_CLIENT_SECRET=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
AUTO_REVERT=false
