# services/api CORS. Comma-separated exact browser origins allowed to call the
# FastAPI backend; unset means every cross-origin browser request is refused.
# A "*" inside an entry is a literal asterisk, not a wildcard -- subdomain
# patterns go in CORS_ALLOWED_ORIGIN_REGEX, which Starlette re.fullmatch-es.
# See docs/GODADDY_INTEGRATION.md. Production for this project is
#   CORS_ALLOWED_ORIGINS=https://app.viraltrending.online
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGIN_REGEX=

# Clerk (dashboard.clerk.com -> API Keys). The publishable key is required
# even to run `next build` -- ClerkProvider reads it during prerendering.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk Dashboard -> Webhooks -> add endpoint -> {NEXT_PUBLIC_APP_URL}/api/webhooks/clerk
# -> subscribe to user.created, user.updated, user.deleted -> copy the signing secret.
CLERK_WEBHOOK_SECRET=
# This app ships its own sign-in/sign-up pages (app/sign-in/[[...sign-in]] and
# app/sign-up/[[...sign-up]]). Without these two, proxy.ts's redirectToSignIn()
# sends users to Clerk's hosted portal instead -- verified: the 307 goes to
# https://<slug>.accounts.dev/sign-in and those two routes are never reached.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard/schedule
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard/schedule

# Supabase (Project Settings -> API). Project ref dcesehxmssqsszzasott
# ("unseen-reels") already has supabase/migrations/0001_viralengine_init.sql
# applied -- ask for its URL/keys rather than provisioning a second project.
#
# One manual, one-time dashboard step is required beyond the migration:
# Authentication -> Sign In / Providers -> Third Party Auth -> add Clerk,
# using your Clerk instance's Frontend API URL. Without this, RLS policies
# comparing auth.jwt()->>'sub' never match, so the RLS-scoped clients in
# lib/supabase/server.ts and lib/supabase/client.ts silently return zero
# rows instead of erroring. The Viral Gap Analyzer route itself doesn't
# depend on this (it reads/writes via the service-role client with an
# explicit user_id filter -- see app/dashboard/analyze/page.tsx), but any
# future feature using the RLS-scoped clients does.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers -> API keys / Webhooks). Test-mode products/prices for
# all three tiers already exist under the "Peshets sandbox" account
# (acct_1UFaOJGZbTaqS7W8) -- ask for their IDs, or create your own in your
# own Stripe account and use those instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# Anthropic (console.anthropic.com -> API Keys). Powers the Viral Gap
# Analyzer's structured audit (lib/anthropic.ts) via the Messages API.
ANTHROPIC_API_KEY=

# Tavily (app.tavily.com -> API Keys). Powers URL content extraction for
# the Viral Gap Analyzer (lib/tavily.ts) via the /extract endpoint, and
# the TikTok/Instagram side of the Creator Account Deep-Dive (same file).
TAVILY_API_KEY=

# Google Cloud Console -> APIs & Services -> Credentials -> API key, with
# the YouTube Data API v3 enabled. Powers the YouTube side of the Creator
# Account Deep-Dive (lib/youtube.ts) -- real channel/upload stats, not a
# scrape. TikTok and Instagram fall back to Tavily extraction above; unlike
# ViralSync's ad-platform OAuth, there's no equivalent official, self-serve
# API for either that a third-party app can call with just an API key.
YOUTUBE_API_KEY=

# Cloudinary (console.cloudinary.com -> Dashboard). Powers the Multimodal
# Video Upload Diagnostic: CLOUDINARY_API_SECRET signs a direct
# browser->Cloudinary upload (lib/cloudinary.ts createSignedVideoUpload)
# so the video's bytes never pass through our own serverless function --
# the real fix for Vercel's ~4.5MB request body ceiling, which a
# multi-hundred-MB video would blow through if proxied. The same secret
# also authenticates the Admin API lookup that fetches the asset's real
# duration server-side rather than trusting the client.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mem0 (app.mem0.ai -> API Keys). Powers the Algorithmic Script &
# Storyboard Generator's creator-voice memory (lib/mem0.ts, via the
# official `mem0ai` npm SDK) -- retrieved before generating a script,
# written back after. Optional in the sense that its absence degrades
# gracefully (scripts still generate, just without prior-style context)
# rather than failing the request -- see lib/mem0.ts and
# docs/DEBUG_RUN.md for how that's surfaced rather than swallowed.
MEM0_API_KEY=

# Used to build Stripe Checkout redirect URLs outside a browser request.
# Production for this project is the app subdomain, not the apex -- the apex
# (viraltrending.online) serves the GoDaddy marketing site. See
# docs/GODADDY_INTEGRATION.md.
#   NEXT_PUBLIC_APP_URL=https://app.viraltrending.online
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# OAuth connections + publish trigger (lib/oauth/, lib/publish/,
# app/api/oauth/[platform]/*, app/api/cron/publish). Of the five services
# investigated for this layer (Descript, OpusClip, HeyGen/HyperFrames,
# Metricool, Canva), only Canva turned out to have a genuine self-serve,
# multi-tenant OAuth product -- the other four are account-linked,
# single-workspace API keys with no way to grant access to an arbitrary end
# user's own account. See docs/VIRALENGINE_ROADMAP.md for the full,
# per-service verified findings. All values below are unset/optional: each
# connect button in /dashboard/settings/connections fails informatively
# (requireEnv()'s error message) rather than silently, until its app is
# registered.
# ---------------------------------------------------------------------------

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application), with the YouTube Data API v3 enabled and a
# youtube.upload consent screen. Distinct from YOUTUBE_API_KEY above (that
# one reads public channel stats; this one uploads video on a connected
# user's behalf) -- deliberately separate credentials. Add
# {NEXT_PUBLIC_APP_URL}/api/oauth/youtube/callback as an authorized
# redirect URI. No review gate for the OAuth grant itself; works for real
# users immediately.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# developers.tiktok.com -> Manage apps -> create an app with the Content
# Posting API's video.publish scope. Distinct from services/api's
# TIKTOK_CLIENT_KEY/SECRET below (a different, unrelated service/app
# registration -- same-named vars there would silently share one TikTok
# app between two unrelated products). Add
# {NEXT_PUBLIC_APP_URL}/api/oauth/tiktok/callback as the redirect URI, and
# verify Cloudinary's res.cloudinary.com domain in the portal so
# PULL_FROM_URL can fetch from it. Posts stay private/self-only until this
# app passes TikTok's content audit.
TIKTOK_OAUTH_CLIENT_KEY=
TIKTOK_OAUTH_CLIENT_SECRET=

# developers.facebook.com -> My Apps -> create an app -> add the Facebook
# Login for Business + Pages Graph API products. Distinct from
# services/api's META_APP_ID/SECRET below (same reasoning as TikTok's
# pair). Add {NEXT_PUBLIC_APP_URL}/api/oauth/facebook/callback as a valid
# OAuth redirect URI. pages_manage_posts requires Meta App Review before
# this works for any account other than a Tester/Developer role on the app.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# canva.dev -> Developer Portal -> Create an integration -> Connect API,
# with design:content:write / design:meta:read / profile:read scopes.
# Requires PKCE (handled by lib/oauth/canva.ts, no extra config). Add
# {NEXT_PUBLIC_APP_URL}/api/oauth/canva/callback as the redirect URI. A
# private integration works immediately for testing; submit it to Canva's
# review queue before real, arbitrary users can connect.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Bearer secret app/api/cron/publish checks on every request -- generate
# any long random string. If deploying to Vercel, set the same value as
# the project's CRON_SECRET env var; Vercel Cron (see vercel.json) then
# sends it automatically. Vercel Cron's minimum interval on the Hobby plan
# is once/day regardless of vercel.json's schedule -- the */15-minute
# schedule configured there needs a Pro (or higher) project, or an
# external scheduler hitting this same URL with this same header.
CRON_SECRET=

# ---------------------------------------------------------------------------
# ViralVision platform service (services/api, services/collab) -- see
# docs/PLATFORM_ROADMAP.md. Everything below is for that separate,
# unbuilt-and-unrun scaffold, not the ViralEngine app above. Leave unset
# unless you're actually standing up services/api locally or in a cluster.
# ---------------------------------------------------------------------------

# Points the Next.js rewrite in next.config.mjs and the tenant-routing half
# of proxy.ts at a running services/api instance. Leave unset to disable both.
INTERNAL_API_URL=
# Shared secret the edge proxy sends as X-Edge-Auth-Secret when calling
# services/api's /api/v1/workspace/resolve-domain fallback.
EDGE_INTERNAL_SECRET=
# Set to "true" to turn on proxy.ts's tenant-routing rewrite. Leave
# unset/false everywhere except a deployment that actually has tenant
# workspaces -- see the safety note at the top of proxy.ts.
MULTI_TENANT_ROUTING_ENABLED=
NEXT_PUBLIC_ROOT_DOMAIN=
NEXT_PUBLIC_PLATFORM_CNAME_TARGET=
NEXT_PUBLIC_WS_COLLAB_URL=

# services/api database + cache
DATABASE_URL=
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_URL=

# services/api Kubernetes domain controller (app/k8s_controller.py)
K8S_NAMESPACE=
PLATFORM_CNAME_TARGET=

# AI generation (app/pipeline/storyboard.py, script_opt.py, repurpose.py,
# competitor.py) -- reuses the ANTHROPIC_API_KEY declared above.
# Verify ANTHROPIC_MODEL against Anthropic's current model list before
# deploying this separate service.
ANTHROPIC_MODEL=

# ElevenLabs voice synthesis (app/pipeline/avatar.py)
ELEVENLABS_API_KEY=

# S3-compatible object storage for raw uploads and renders
# (app/routers/storage.py). Set S3_ENDPOINT_URL for Supabase Storage/MinIO.
S3_MEDIA_BUCKET=
AWS_REGION=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# LiveKit community/events rooms (app/routers/events.py)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Direct social OAuth + publishing (app/routers/social.py), for this
# separate platform service only.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# services/collab
COLLAB_PORT=
