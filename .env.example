# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers -> API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# TikTok for Business (Marketing API) app credentials — from
# business-api.tiktok.com after app review. Required for both the OAuth
# "Connect TikTok Ads" flow and the distribution gateway.
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Google Ads API — OAuth client from Google Cloud Console, plus a
# developer token from the Google Ads Manager account (subject to
# Google's approval process). Required for "Connect Google Ads" and the
# distribution gateway.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Used to build Stripe Checkout / OAuth redirect URLs outside a browser request
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# ViralVision platform service (services/api, services/collab) -- see
# docs/PLATFORM_ROADMAP.md. Everything below is for that separate,
# unbuilt-and-unrun scaffold, not the ViralSync app above. Leave unset
# unless you're actually standing up services/api locally or in a cluster.
# ---------------------------------------------------------------------------

# Points the Next.js rewrite in next.config.mjs and middleware.ts at a
# running services/api instance. Leave unset to disable both.
INTERNAL_API_URL=
# Shared secret the edge middleware sends as X-Edge-Auth-Secret when
# calling services/api's /api/v1/workspace/resolve-domain fallback.
EDGE_INTERNAL_SECRET=
# Set to "true" to turn on middleware.ts's tenant-routing rewrite. Leave
# unset/false everywhere except a deployment that actually has tenant
# workspaces -- see the safety note at the top of middleware.ts.
MULTI_TENANT_ROUTING_ENABLED=
NEXT_PUBLIC_ROOT_DOMAIN=
NEXT_PUBLIC_PLATFORM_CNAME_TARGET=
NEXT_PUBLIC_WS_COLLAB_URL=

# services/api database + cache
DATABASE_URL=
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_URL=

# services/api Kubernetes domain controller (app/k8s_controller.py)
K8S_NAMESPACE=
PLATFORM_CNAME_TARGET=

# Local inference (app/core/llm.py). No API key: the pipeline steps run
# against Ollama on your own hardware. Leave OLLAMA_MODEL unset to pick by
# detected VRAM (>=12GB -> 14B, else 8B); pin it in production.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=
# "0" evicts the model after each call so faster-whisper and CLIP can use
# the same GPU. Set "5m" on a card with room to spare to skip reloads.
OLLAMA_KEEP_ALIVE=0
OLLAMA_TIMEOUT_SECONDS=600

# Local text-to-speech (app/core/tts.py). No API key.
#   kokoro     Apache-2.0, 54 preset voices, fast on CPU (default)
#   chatterbox MIT, clones a voice from ~5s of reference audio
#   piper      MIT, tiny and very fast, lower fidelity
# NOT offered: XTTS-v2 -- its weights are non-commercial licensed.
TTS_BACKEND=kokoro
# kokoro/piper: a preset name. chatterbox: path to reference audio.
TTS_DEFAULT_VOICE=af_heart

# S3-compatible object storage for raw uploads and renders
# (app/routers/storage.py). Works with any S3 API: set the endpoint for a
# self-hosted store (SeaweedFS, Garage), Supabase Storage or R2, and leave
# it unset for AWS. Not MinIO -- its community server was archived in
# April 2026 and receives no security patches.
S3_MEDIA_BUCKET=
S3_ENDPOINT_URL=
# Browser-facing base URL when objects sit behind a CDN or reverse proxy.
# Defaults to the endpoint above, or the AWS URL when there is none.
S3_PUBLIC_BASE_URL=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# LiveKit community/events rooms (app/routers/events.py)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Direct social OAuth + publishing (app/routers/social.py) -- separate
# from the TikTok/Google Ads vars above, which are for the ViralSync
# amplification flow, not this platform service.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# services/collab
COLLAB_PORT=
