# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers -> API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# Official distribution APIs (leave blank until compliance review + OAuth
# app approval are complete — lib/distribution.ts refuses to run without
# these, by design)
TIKTOK_API_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Used to build Stripe Checkout success/cancel URLs outside a browser request
NEXT_PUBLIC_APP_URL=http://localhost:3000
