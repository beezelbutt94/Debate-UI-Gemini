# Next.js production image using the standalone output trace (see
# `output: "standalone"` in next.config.mjs).
#
# Node 22, not 20: @supabase/supabase-js and its sub-packages declare
# `engines.node >= 22.0.0`, so a Node 20 base only "works" because npm
# downgrades that to a warning.
FROM node:22-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production

# public/ is kept in git via public/.gitkeep — this COPY fails the build
# outright if the directory is missing.
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

USER node
EXPOSE 3000
CMD ["node", "server.js"]
